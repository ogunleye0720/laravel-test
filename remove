#!/usr/bin/env python3
"""
Remove active and commented-out Terraform `moved` and `import` blocks from one
repository directory.

The script scans all Terraform (*.tf) files recursively inside one selected
repository subdirectory.

Safety:
  - Dry-run mode is the default.
  - Files are changed only when --apply is supplied.
  - A .bak copy is created before each changed file unless --no-backup is used.

Examples:
    python remove_terraform_blocks.py account-upgrade repository-name

    python remove_terraform_blocks.py account-upgrade repository-name \
        --apply

    python remove_terraform_blocks.py account-upgrade repository-name \
        --apply --no-backup
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import sys
from dataclasses import dataclass
from pathlib import Path


SKIPPED_DIRECTORIES = {
    ".git",
    ".terraform",
    ".terragrunt-cache",
    "__pycache__",
    "node_modules",
    "vendor",
}

BLOCK_START_PATTERN = re.compile(r"^(moved|import)\s*\{")


@dataclass(frozen=True)
class BlockRange:
    start_line: int
    end_line: int
    block_type: str
    comment_style: str


@dataclass
class BraceState:
    in_string: bool = False
    escaped: bool = False
    in_block_comment: bool = False


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Remove Terraform moved/import blocks from one repository "
            "subdirectory."
        )
    )
    parser.add_argument(
        "root",
        help="Directory containing the cloned repositories.",
    )
    parser.add_argument(
        "repository",
        help=(
            "Name of the immediate repository subdirectory to clean. "
            "A path outside the root directory is not accepted."
        ),
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Write the changes. Without this option, only a dry run is done.",
    )
    parser.add_argument(
        "--no-backup",
        action="store_true",
        help="Do not create .bak files before applying changes.",
    )
    return parser.parse_args()


def find_terraform_files(repository_path: Path) -> list[Path]:
    terraform_files: list[Path] = []

    for current_root, directory_names, file_names in os.walk(
        repository_path,
        followlinks=False,
    ):
        directory_names[:] = [
            name
            for name in directory_names
            if name not in SKIPPED_DIRECTORIES
        ]

        current_path = Path(current_root)

        for file_name in file_names:
            if file_name.endswith(".tf"):
                terraform_files.append(current_path / file_name)

    return sorted(terraform_files)


def block_comment_state_at_line_start(lines: list[str]) -> list[bool]:
    """Record whether each line starts inside a /* ... */ comment."""
    states: list[bool] = []
    in_block_comment = False
    in_string = False
    escaped = False

    for line in lines:
        states.append(in_block_comment)
        index = 0

        while index < len(line):
            current = line[index]
            next_char = line[index + 1] if index + 1 < len(line) else ""

            if in_block_comment:
                if current == "*" and next_char == "/":
                    in_block_comment = False
                    index += 2
                else:
                    index += 1
                continue

            if in_string:
                if escaped:
                    escaped = False
                elif current == "\\":
                    escaped = True
                elif current == '"':
                    in_string = False

                index += 1
                continue

            if current == '"':
                in_string = True
                index += 1
                continue

            if current == "#":
                break

            if current == "/" and next_char == "/":
                break

            if current == "/" and next_char == "*":
                in_block_comment = True
                index += 2
                continue

            index += 1

    return states


def detect_block_start(
    line: str,
    starts_inside_block_comment: bool,
) -> tuple[str, str] | None:
    """Return (block_type, comment_style) when a target block starts."""
    stripped = line.lstrip()

    if starts_inside_block_comment:
        candidate = stripped
        if candidate.startswith("*"):
            candidate = candidate[1:].lstrip()

        match = BLOCK_START_PATTERN.match(candidate)
        if match:
            return match.group(1), "block"
        return None

    if stripped.startswith("#"):
        match = BLOCK_START_PATTERN.match(stripped[1:].lstrip())
        if match:
            return match.group(1), "hash"
        return None

    if stripped.startswith("//"):
        match = BLOCK_START_PATTERN.match(stripped[2:].lstrip())
        if match:
            return match.group(1), "slash"
        return None

    if stripped.startswith("/*"):
        candidate = stripped[2:].lstrip()
        if candidate.startswith("*"):
            candidate = candidate[1:].lstrip()

        match = BLOCK_START_PATTERN.match(candidate)
        if match:
            return match.group(1), "block"
        return None

    match = BLOCK_START_PATTERN.match(stripped)
    if match:
        return match.group(1), "active"

    return None


def normalize_line_for_style(line: str, comment_style: str) -> str:
    """Remove the outer marker used to comment out a Terraform block."""
    stripped = line.lstrip()

    if comment_style == "hash":
        return stripped[1:].lstrip() if stripped.startswith("#") else stripped

    if comment_style == "slash":
        return stripped[2:].lstrip() if stripped.startswith("//") else stripped

    if comment_style == "block":
        if stripped.startswith("/*"):
            stripped = stripped[2:].lstrip()
        if stripped.startswith("*"):
            stripped = stripped[1:].lstrip()
        if "*/" in stripped:
            stripped = stripped.split("*/", 1)[0]
        return stripped

    return line


def count_braces(text: str, state: BraceState) -> int:
    """Count braces outside strings and HCL comments."""
    delta = 0
    index = 0

    while index < len(text):
        current = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""

        if state.in_block_comment:
            if current == "*" and next_char == "/":
                state.in_block_comment = False
                index += 2
            else:
                index += 1
            continue

        if state.in_string:
            if state.escaped:
                state.escaped = False
            elif current == "\\":
                state.escaped = True
            elif current == '"':
                state.in_string = False

            index += 1
            continue

        if current == '"':
            state.in_string = True
            index += 1
            continue

        if current == "#":
            break

        if current == "/" and next_char == "/":
            break

        if current == "/" and next_char == "*":
            state.in_block_comment = True
            index += 2
            continue

        if current == "{":
            delta += 1
        elif current == "}":
            delta -= 1

        index += 1

    return delta


def is_standalone_comment_opener(line: str) -> bool:
    return re.fullmatch(r"\s*/\*\s*", line.rstrip("\r\n")) is not None


def is_standalone_comment_closer(line: str) -> bool:
    return re.fullmatch(r"\s*\*/\s*", line.rstrip("\r\n")) is not None


def find_block_end(
    lines: list[str],
    start_line: int,
    comment_style: str,
) -> int | None:
    balance = 0
    opening_brace_seen = False
    brace_state = BraceState()

    for line_number in range(start_line, len(lines)):
        normalized_line = normalize_line_for_style(
            lines[line_number],
            comment_style,
        )
        line_delta = count_braces(normalized_line, brace_state)

        if "{" in normalized_line:
            opening_brace_seen = True

        balance += line_delta

        if opening_brace_seen and balance == 0:
            return line_number + 1

    return None


def find_block_ranges(
    lines: list[str],
    source_path: Path,
) -> list[BlockRange]:
    block_ranges: list[BlockRange] = []
    block_comment_states = block_comment_state_at_line_start(lines)
    line_number = 0

    while line_number < len(lines):
        detected = detect_block_start(
            lines[line_number],
            block_comment_states[line_number],
        )

        if detected is None:
            line_number += 1
            continue

        block_type, comment_style = detected
        end_line = find_block_end(lines, line_number, comment_style)

        if end_line is None:
            print(
                f"Warning: skipped an unclosed {block_type} block in "
                f"{source_path}:{line_number + 1}",
                file=sys.stderr,
            )
            line_number += 1
            continue

        start_line = line_number

        if comment_style == "block":
            starts_with_opener = lines[start_line].lstrip().startswith("/*")

            if (
                not starts_with_opener
                and start_line > 0
                and is_standalone_comment_opener(lines[start_line - 1])
            ):
                start_line -= 1

            if (
                end_line < len(lines)
                and is_standalone_comment_closer(lines[end_line])
            ):
                end_line += 1
            elif starts_with_opener and "*/" not in "".join(
                lines[line_number:end_line]
            ):
                print(
                    f"Warning: skipped an ambiguous /* ... */ commented "
                    f"{block_type} block in {source_path}:{line_number + 1}",
                    file=sys.stderr,
                )
                line_number = end_line
                continue

        block_ranges.append(
            BlockRange(
                start_line=start_line,
                end_line=end_line,
                block_type=block_type,
                comment_style=comment_style,
            )
        )
        line_number = end_line

    return block_ranges


def remove_ranges(
    lines: list[str],
    block_ranges: list[BlockRange],
) -> list[str]:
    lines_to_remove: set[int] = set()

    for block_range in block_ranges:
        lines_to_remove.update(
            range(block_range.start_line, block_range.end_line)
        )

    return [
        line
        for index, line in enumerate(lines)
        if index not in lines_to_remove
    ]


def next_backup_path(source_path: Path) -> Path:
    candidate = source_path.with_name(f"{source_path.name}.bak")
    counter = 1

    while candidate.exists():
        candidate = source_path.with_name(
            f"{source_path.name}.bak.{counter}"
        )
        counter += 1

    return candidate


def write_updated_file(
    source_path: Path,
    updated_content: str,
    create_backup: bool,
) -> Path | None:
    backup_path: Path | None = None

    if create_backup:
        backup_path = next_backup_path(source_path)
        shutil.copy2(source_path, backup_path)

    source_path.write_text(updated_content, encoding="utf-8")
    return backup_path


def main() -> int:
    arguments = parse_arguments()

    root_directory = Path(arguments.root).expanduser().resolve()
    repository_path = (root_directory / arguments.repository).resolve()

    if not root_directory.is_dir():
        print(
            f"Error: root directory does not exist: {root_directory}",
            file=sys.stderr,
        )
        return 1

    if repository_path.parent != root_directory:
        print(
            "Error: repository must be an immediate subdirectory of the root.",
            file=sys.stderr,
        )
        return 1

    if not repository_path.is_dir():
        print(
            f"Error: repository directory does not exist: {repository_path}",
            file=sys.stderr,
        )
        return 1

    terraform_files = find_terraform_files(repository_path)
    changed_files = 0
    moved_blocks = 0
    import_blocks = 0

    mode_label = "APPLY" if arguments.apply else "DRY RUN"
    print(f"Mode: {mode_label}")
    print(f"Repository: {repository_path}")
    print(f"Terraform files scanned: {len(terraform_files)}")

    for terraform_file in terraform_files:
        try:
            original_content = terraform_file.read_text(
                encoding="utf-8",
                errors="replace",
            )
        except OSError as error:
            print(
                f"Warning: could not read {terraform_file}: {error}",
                file=sys.stderr,
            )
            continue

        lines = original_content.splitlines(keepends=True)
        block_ranges = find_block_ranges(lines, terraform_file)

        if not block_ranges:
            continue

        file_moved_blocks = sum(
            block_range.block_type == "moved"
            for block_range in block_ranges
        )
        file_import_blocks = sum(
            block_range.block_type == "import"
            for block_range in block_ranges
        )

        updated_content = "".join(remove_ranges(lines, block_ranges))
        relative_path = terraform_file.relative_to(repository_path)

        print(
            f"{'Updated' if arguments.apply else 'Would update'}: "
            f"{relative_path} "
            f"(moved={file_moved_blocks}, import={file_import_blocks})"
        )

        if arguments.apply:
            try:
                backup_path = write_updated_file(
                    terraform_file,
                    updated_content,
                    create_backup=not arguments.no_backup,
                )
            except OSError as error:
                print(
                    f"Error: could not update {terraform_file}: {error}",
                    file=sys.stderr,
                )
                continue

            if backup_path is not None:
                print(
                    f"  Backup: "
                    f"{backup_path.relative_to(repository_path)}"
                )

        changed_files += 1
        moved_blocks += file_moved_blocks
        import_blocks += file_import_blocks

    print("")
    print(f"Files {'updated' if arguments.apply else 'to update'}: {changed_files}")
    print(f"Moved blocks {'removed' if arguments.apply else 'found'}: {moved_blocks}")
    print(f"Import blocks {'removed' if arguments.apply else 'found'}: {import_blocks}")

    if not arguments.apply and changed_files > 0:
        print("")
        print("No files were changed. Re-run with --apply after reviewing the output.")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
