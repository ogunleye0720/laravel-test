locals {
  # Not a variable on purpose. Elastic's values.yaml hardcodes this namespace in the
  # auto-instrumentation exporter endpoint
  # (opentelemetry-kube-stack-daemon-collector.opentelemetry-operator-system.svc.cluster.local),
  # so installing elsewhere silently breaks instrumented workloads.
  namespace = "opentelemetry-operator-system"

  release_name = "opentelemetry-kube-stack"

  repository = "https://open-telemetry.github.io/opentelemetry-helm-charts"
  chart      = "opentelemetry-kube-stack"

  secret_name = "elastic-secret-otel"

  tolerations = [for t in var.tolerations : { for k, v in t : k => v if v != null }]

  daemonset_node_selector = { "kubernetes.io/os" = "linux" }
  daemonset_tolerations   = [{ operator = "Exists" }]

  scheduling_overlay = yamlencode({
    "opentelemetry-operator" = {
      nodeSelector = var.node_selector
      tolerations  = local.tolerations
    }
    collectors = {
      cluster = {
        nodeSelector = var.node_selector
        tolerations  = local.tolerations
      }
      gateway = {
        nodeSelector = var.node_selector
        tolerations  = local.tolerations
      }
      daemon = {
        nodeSelector = local.daemonset_node_selector
        tolerations  = local.daemonset_tolerations
      }
    }
  })

  instrumentation_overlay = yamlencode({
    instrumentation = {
      exporter = {
        endpoint = "http://opentelemetry-kube-stack-daemon-collector.${local.namespace}.svc.cluster.local:4318"
      }
    }
  })

  gateway_pipeline_processors = {
    metrics                           = ["resource/data_stream_namespace", "batch/metrics"]
    logs                              = ["resource/data_stream_namespace", "batch"]
    traces                            = ["resource/data_stream_namespace", "batch", "elasticapm"]
    "metrics/aggregated-otel-metrics" = ["resource/data_stream_namespace"]
  }

  data_stream_namespace_overlay = var.data_stream_namespace == null ? [] : [yamlencode({
    collectors = {
      gateway = {
        config = {
          processors = {
            "resource/data_stream_namespace" = {
              attributes = [{
                key    = "data_stream.namespace"
                action = "upsert"
                value  = var.data_stream_namespace
              }]
            }
          }
          service = {
            pipelines = {
              for name, processors in local.gateway_pipeline_processors :
              name => { processors = processors }
            }
          }
        }
      }
    }
  })]

  # Only emitted when the operator explicitly overrides upstream auto-detection.
  cluster_name_overlay = var.cluster_name == null ? [] : [yamlencode({ clusterName = var.cluster_name })]

  # Later documents win, so consumer overrides are layered last.
  helm_values = concat(
    [file("${path.module}/values.yaml")],
    [local.scheduling_overlay],
    [local.instrumentation_overlay],
    local.data_stream_namespace_overlay,
    local.cluster_name_overlay,
  )
}
