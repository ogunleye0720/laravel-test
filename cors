def test_custom_cors_origin(terraform_output: Dict[str, Any]) -> None:
    url = _base_url(terraform_output)

    response = requests.get(
        url,
        headers={
            "Origin": "https://test.com",
        },
        timeout=30,
    )

    assert response.status_code == 200
    assert (
        response.headers.get("access-control-allow-origin")
        == "https://test.com"
    )


def test_custom_cors_headers_policy(
    terraform_output: Dict[str, Any],
) -> None:
    cloudfront_id = terraform_output["cloudfront_id"]["value"]
    client = boto3.client("cloudfront")

    distribution = client.get_distribution_config(
        Id=cloudfront_id,
    )["DistributionConfig"]

    response_headers_policy_id = distribution[
        "DefaultCacheBehavior"
    ].get("ResponseHeadersPolicyId")

    assert response_headers_policy_id, (
        "No response headers policy is attached to the "
        "default cache behaviour"
    )

    policy = client.get_response_headers_policy(
        Id=response_headers_policy_id,
    )

    cors_config = policy[
        "ResponseHeadersPolicy"
    ]["ResponseHeadersPolicyConfig"]["CorsConfig"]

    allowed_headers = set(
        cors_config["AccessControlAllowHeaders"]["Items"]
    )
    allowed_methods = set(
        cors_config["AccessControlAllowMethods"]["Items"]
    )
    allowed_origins = set(
        cors_config["AccessControlAllowOrigins"]["Items"]
    )
    exposed_headers = set(
        cors_config["AccessControlExposeHeaders"]["Items"]
    )

    assert allowed_headers == EXPECTED_ALLOWED_HEADERS
    assert allowed_methods == EXPECTED_ALLOWED_METHODS
    assert allowed_origins == {EXPECTED_ORIGIN}
    assert exposed_headers == {"ETag"}
    assert cors_config["OriginOverride"] is True
